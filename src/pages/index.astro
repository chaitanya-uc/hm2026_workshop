---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories } from '../lib/categories';
import { getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5 shadow-lg" data-testid="games-filters">
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div class="w-full lg:max-w-2xl">
          <h2 class="mb-3 text-lg font-semibold text-slate-100">Filter games</h2>
          <fieldset>
            <legend class="mb-2 block text-sm font-medium text-slate-300">Categories</legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label
                  for={`category-${category.id}`}
                  class="inline-flex items-center gap-2 rounded-full border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 hover:text-white"
                >
                  <input
                    id={`category-${category.id}`}
                    type="checkbox"
                    value={String(category.id)}
                    data-category-id={String(category.id)}
                    data-testid="category-filter"
                    class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="w-full max-w-xs">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-300">Publisher</label>
          <select
            id="publisher-filter"
            data-testid="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={String(publisher.id)}>{publisher.name}</option>
            ))}
          </select>
        </div>
      </div>
    </section>

    <div>
      <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-testid="game-card-container"
                data-game-id={String(game.id)}
                data-game-category-id={game.category ? String(game.category.id) : ''}
                data-game-publisher-id={game.publisher ? String(game.publisher.id) : ''}
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>

          <div class="hidden pt-6" data-testid="no-matches-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilters = Array.from(document.querySelectorAll('[data-testid="category-filter"]'));
  const publisherFilter = document.querySelector('[data-testid="publisher-filter"]');
  const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card-container"]'));
  const emptyState = document.querySelector('[data-testid="no-matches-empty-state"]');

  function applyFilters() {
    const selectedCategories = categoryFilters
      .filter((checkbox) => checkbox instanceof HTMLInputElement && checkbox.checked)
      .map((checkbox) => Number((checkbox as HTMLInputElement).value));

    const selectedPublisherId =
      publisherFilter instanceof HTMLSelectElement && publisherFilter.value
        ? Number(publisherFilter.value)
        : null;

    let visibleCount = 0;

    gameCards.forEach((card) => {
      const categoryId = Number(card.getAttribute('data-game-category-id') || '0');
      const publisherId = Number(card.getAttribute('data-game-publisher-id') || '0');
      const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(categoryId);
      const matchesPublisher = selectedPublisherId === null || publisherId === selectedPublisherId;
      const isVisible = matchesCategory && matchesPublisher;

      if (card instanceof HTMLElement) {
        card.classList.toggle('hidden', !isVisible);
      }

      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (emptyState instanceof HTMLElement) {
      emptyState.classList.toggle('hidden', visibleCount > 0);
    }
  }

  if (categoryFilters.length > 0 || publisherFilter) {
    categoryFilters.forEach((checkbox) => {
      checkbox.addEventListener('change', applyFilters);
    });

    if (publisherFilter) {
      publisherFilter.addEventListener('change', applyFilters);
    }
  }
</script>
